# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Runtime data — SQLite DB, persistent thumb cache, downloaded files.
data/
weights/
yolov8s-world.pt
lock_wal.db

# Private: hand-labeled photo batches (personal filenames + asset UUIDs)
# and the offline person-classifier experiment workflow. Kept locally,
# not published — they're dev-only and not needed to run the app.
data/label_sample/
scripts/person_*
scripts/PERSON_CLASSIFIER.md

# Private: Colab experiment notebooks (reference a personal GCS bucket).
colab/

# Private: BioTrove vs ToL-10M overlap analysis (hardcoded local cache
# paths + a 2.5 MB derived CSV). Dev-only, not published.
docs/biotrove_compare/

# Orphan SQLite files at the repo root (the `data/` directory is already
# covered by the rule above). `data.state.db` is a real risk: a fresh
# run drops a ~500 MB file at the root that has nothing to do with
# the data/ directory but is easy to accidentally `git add .`.
*.db
*.db-shm
*.db-wal
data.state.db

# User config — `config.example.toml` is committed; the real one is not.
config.toml

# Secrets / local config
.env

# Editor / tooling
.claude/
.vscode/
.idea/
.DS_Store

# React frontend (Vite)
frontend/node_modules/
frontend/dist/
