# BotaniSense for Immich — environment secrets template.
#
# Copy this file to `.env` (which is gitignored) and fill in your
# Immich admin API key. You can enter this in the web UI instead
# (Welcome screen → Connect Immich) — the environment is for
# automation or pinning the value so UI edits can't change it.
#
# After editing, restart uvicorn — python-dotenv only reads .env on
# startup.

# Required. Immich admin API key. Generate one in the Immich web UI:
#   Administration → Settings → API Keys → New API Key
# Mark "Asset Read" + "Album Read/Write" + "Library Read" scopes; admin
# scope is not required.
IMMICH_API_KEY=

# Optional. IANA zone name for log timestamps. compose.yml mounts the
# host's /etc/localtime, which covers Linux; set TZ when that mount is
# unavailable (Docker Desktop on macOS/Windows) or you want to pin a
# zone regardless of the host.
# TZ=Asia/Shanghai
